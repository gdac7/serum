NODE_ENV=development
PORT=3000
LOG_LEVEL=info
PYTHON_SERVICE_URL=http://localhost:8080

# Gateway's own Postgres (separate instance from the Python service's DB).
GATEWAY_DATABASE_URL=postgresql://gateway:gateway@localhost:5433/gateway

# Auth. Use a long random value in real deployments (min 16 chars).
JWT_SECRET=dev-only-change-me-please
JWT_EXPIRES_SECONDS=3600
