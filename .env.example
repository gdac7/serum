# Copy to .env next to docker-compose.yml and fill in. Compose reads this file
# automatically to interpolate ${...} in docker-compose.yml. Never commit .env.
#
# Generate each secret with: openssl rand -hex 32

# Postgres passwords. Set before the first `up` — changing one afterwards does
# not change the password already baked into the volume's data directory.
RT_PG_PASSWORD=
GW_PG_PASSWORD=

# Gateway secrets. Rotating JWT_SECRET logs everyone out; rotating
# SECRETS_ENC_KEY makes every stored target API key undecryptable.
JWT_SECRET=
SECRETS_ENC_KEY=
BRIDGE_SECRET=

# The hostname users' connectors dial. Must be https and publicly resolvable or
# the gateway refuses to boot under NODE_ENV=production.
PUBLIC_BASE_URL=https://api.example.com

# From Zero Trust → Networks → Tunnels → your tunnel.
TUNNEL_TOKEN=

# Optional: needed only for gated Hugging Face weights.
HF_TOKEN=

# Optional: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
JWT_EXPIRES_SECONDS=3600
