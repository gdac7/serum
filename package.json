{
  "name": "serum",
  "version": "0.1.0",
  "private": true,
  "description": "Red teaming platform for LLM agents: gateway, red-team service, connector and web app.",
  "workspaces": [
    "apps/gateway",
    "apps/webapp"
  ],
  "scripts": {
    "dev:gateway": "npm run dev -w apps/gateway",
    "dev:worker": "npm run worker -w apps/gateway",
    "dev:webapp": "npm run dev -w apps/webapp",
    "migrate": "npm run migrate -w apps/gateway",
    "build": "npm run build -w apps/webapp",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "msgpackr-extract@3.0.4": true
  }
}
